# Example env for admin portal
# Required (set these in production environment, not committed to repo):
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here   # SERVER-ONLY, DO NOT COMMIT
ADMIN_UI_SECRET=some-long-secret-for-admin-api         # SERVER-ONLY, used by verifyAdminAuth()
# Optional: for local dev only (exposes the UI auth token to the client bundle).
# Per PROD-012 the UI auth token is intentionally allowed on the client; rotate
# regularly and never reuse the same value as a true secret.
NEXT_PUBLIC_ADMIN_UI_SECRET=some-long-secret-for-admin-api

# Optional public configuration
# NEXT_PUBLIC_CDN_URL=https://cdn.example.com
# NEXT_PUBLIC_ADMIN_API_URL=https://admin.example.com

# DO NOT add any other NEXT_PUBLIC_* variables that contain secrets.
# Forbidden examples (would leak to browser bundle):
#   NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY
#   NEXT_PUBLIC_STRIPE_SECRET_KEY
#   NEXT_PUBLIC_SENDGRID_API_KEY
#   NEXT_PUBLIC_TWILIO_AUTH_TOKEN
